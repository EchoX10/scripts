-- 💃 IDs dos emotes (fallback via LoadAnimation)
-- ===============================================
local EMOTE_IDS = {
    dance1 = 507770818,
    dance2 = 507777826,
    dance3 = 507771019,
    cheer  = 507770677,
    wave   = 507770239,
    laugh  = 507770699,
