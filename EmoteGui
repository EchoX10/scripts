}

-- ===============================================
-- 💃 TOCAR EMOTE (3 métodos + fallback anim)
-- ===============================================
local function playEmote(emoteName)
    local char = LocalPlayer.Character
    if not char then return false, "sem char" end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false, "sem humanoid" end

    -- Método 1: Humanoid:PlayEmote (API oficial)
    local ok, res = pcall(function()
        return humanoid:PlayEmote(emoteName)
    end)
    if ok and res then return true, "PlayEmote" end

    -- Método 2: Animate.PlayEmote BindableFunction
    local animate = char:FindFirstChild("Animate")
    if animate then
        for _, child in ipairs(animate:GetDescendants()) do
            if child:IsA("BindableFunction")
            and child.Name:lower():find("emote") then
                local ok2, res2 = pcall(function() return child:Invoke(emoteName) end)
                if ok2 and res2 then return true, "Animate" end
            end
        end
    end

    -- Método 3: carregar animação direto pelo ID
    local id = EMOTE_IDS[emoteName]
    if id then
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator"); animator.Parent = humanoid
        end
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. id
        local ok3, track = pcall(function() return animator:LoadAnimation(anim) end)
        if ok3 and track then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                local tid = t.Animation and t.Animation.AnimationId or ""
                if tid:match("50777") then t:Stop() end
            end
            track:Play()
            return true, "Anim"
        end
    end

    return false, "falhou"
end

-- ===============================================
-- 💬 Chat (fallback para ficar visível no RP)
-- ===============================================
local function sendChat(msg)
    pcall(function()
        local ev = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if ev and ev:FindFirstChild("SayMessageRequest") then
            ev.SayMessageRequest:FireServer(msg, "All"); return
        end
    end)
    pcall(function()
        local TCS = game:GetService("TextChatService")
        if TCS.ChatVersion == Enum.ChatVersion.TextChatService then
            local ch = TCS:FindFirstChild("TextChannels")
            local gen = ch and ch:FindFirstChild("RBXGeneral")
            if gen then gen:SendAsync(msg) end
        end
    end)
end

