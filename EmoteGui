local toastToken = 0
local function showToast(txt, ok)
    toastToken = toastToken + 1
    local my = toastToken
    toast.Text = (ok and "✅ " or "❌ ") .. txt
    toast.Visible = true
    toast.TextTransparency = 0
    toast.BackgroundTransparency = 0.15
    task.delay(1.6, function()
        if my ~= toastToken then return end
        TweenService:Create(toast, TweenInfo.new(0.4), {
            TextTransparency = 1, BackgroundTransparency = 1
        }):Play()
        task.delay(0.45, function() if my == toastToken then toast.Visible = false end end)
    end)
end

