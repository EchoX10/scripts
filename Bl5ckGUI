local function iniciarSistemaDeTiro()
    if conexaoTiro then conexaoTiro:Disconnect() end
    local function dispararTiro(posInicio, direcao)
        local posBala = posInicio + direcao * 3
        local cframeInicial = CFrame.new(posBala, posBala + direcao)
        local bala = F3X:CreatePart("Normal", cframeInicial, workspace)
        if not bala then return end
        F3X:Resize(bala, Vector3.new(1.2, 1.2, 5))
        F3X:SetColor(bala, Color3.fromRGB(255, 255, 0))
        F3X:Anchor(bala)
        F3X:SetCollision(bala, false)
        local atingiu = false
        local velocidade = 200
        local dt = 0.02
        local tempoDecorrido = 0
        local posAtual = posBala
        local function verificarAcerto()
            if atingiu then return end
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= plr and player.Character then
                    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - posAtual).Magnitude < 3 then
                        atingiu = true
                        cmdHD(";dmg " .. player.Name .. " 10")
                        return
                    end
                end
            end
        end
        local conexaoTouched = bala.Touched:Connect(function(hit)
            if atingiu then return end
            local char = hit:FindFirstAncestorOfClass("Model")
            if char and char ~= plr.Character then
                local playerAlvo = Players:GetPlayerFromCharacter(char)
                if playerAlvo and char:FindFirstChild("Humanoid") then
                    atingiu = true
                    cmdHD(";dmg " .. playerAlvo.Name .. " 10")
                end
            end
        end)
        task.spawn(function()
            while not atingiu and tempoDecorrido < 7 do
                task.wait(dt)
                tempoDecorrido = tempoDecorrido + dt
                if not bala or not bala.Parent then break end
                posAtual = posAtual + direcao * (velocidade * dt)
                pcall(function() F3X:Move(bala, CFrame.new(posAtual, posAtual + direcao)) end)
                verificarAcerto()
            end
            conexaoTouched:Disconnect()
            if bala and bala.Parent then pcall(function() F3X:Remove(bala) end) end
        end)
    end
    local function getPosInicio()
        if partesClone["_ArmaCano"] and partesClone["_ArmaCano"].Parent then
            return partesClone["_ArmaCano"].Position
        end
        local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position + Vector3.new(0, 1, 0) end
        return nil
    end
    conexaoTiro = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or not cloneAtivo or not armaAtiva then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local mouse = plr:GetMouse()
            local posInicio = getPosInicio()
            if not posInicio or not mouse.Target then return end
            dispararTiro(posInicio, (mouse.Hit.Position - posInicio).Unit)
        elseif input.UserInputType == Enum.UserInputType.Touch then
            local posInicio = getPosInicio()
            if not posInicio then return end
            local camera = workspace.CurrentCamera
            if not camera then return end
            local ray = camera:ScreenPointToRay(input.Position.X, input.Position.Y)
            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = {plr.Character}
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            local resultado = workspace:Raycast(ray.Origin, ray.Direction * 500, rayParams)
            local alvo = resultado and resultado.Position or (ray.Origin + ray.Direction * 500)
            dispararTiro(posInicio, (alvo - posInicio).Unit)
        end
    end)
end

local function pararSistemaDeTiro()
    if conexaoTiro then conexaoTiro:Disconnect() conexaoTiro = nil end
end

local function toggleClonePersonagem(ativar)
    local seBTP = getFork3XEndpoint()
    if not seBTP then
        notifyErro("Building Tools+ nÃ£o encontrada!")
        return
    end
    if ativar then
        if cloneAtivo then return end
        cloneAtivo = true
        cmdHD(";invisible")
        local char = plr.Character
        if not char then return end
        local localSeguro = Vector3.new(0, -200, 0)
        for _, dados in ipairs(BLUEPRINT_PERSONAGEM) do
            local parteOriginal = char:FindFirstChild(dados.n)
            if parteOriginal and parteOriginal:IsA("BasePart") then
                local clone = F3X:CreatePart("Normal", CFrame.new(localSeguro), workspace)
                if clone then
                    F3X:Resize(clone, dados.s)
                    F3X:SetColor(clone, dados.c)
                    pcall(function() clone.Material = Enum.Material[dados.m] end)
                    if dados.t then F3X:SetTransparency(clone, dados.t) else F3X:SetTransparency(clone, 0) end
                    if dados.n == "Head" then
                        task.wait(0.05)
                        pcall(function() seBTP:InvokeServer("CreateMeshes", {{Part = clone}}) end)
                        task.wait(0.05)
                        pcall(function()
                            seBTP:InvokeServer("SyncMesh", {{
                                Part = clone, MeshType = "Head", Mesh = 0, TextureId = 0,
                                Scale = Vector3.new(1.25, 1.25, 1.25)
                            }})
                        end)
                    end
                    F3X:SetCollision(clone, false)
                    F3X:Anchor(clone)
                    F3X:Move(clone, parteOriginal.CFrame)
                    task.wait(0.1)
                    if dados.weld then
                        if criarWeldServerSide(seBTP, clone, parteOriginal) then
                            F3X:Unanchor(clone)
                            partesClone[dados.n] = clone
                        else
                            F3X:Anchor(clone)
                            partesClone[dados.n] = clone
                        end
                    else
                        F3X:Unanchor(clone)
                        partesClone[dados.n] = clone
                    end
                end
            end
        end
        criarGuiArma()
        iniciarSistemaDeTiro()
        iniciarAnimacaoCabeca()
        iniciarAnimacaoCorpo()
        notifySucesso("Clone ativado!")
    else
        if not cloneAtivo then return end
        cloneAtivo = false
        cmdHD(";visible")
        pararSistemaDeTiro()
        desativarArmaDoClone()
        if guiArmaToggle then guiArmaToggle:Destroy() guiArmaToggle = nil end
        armaAtiva = false
        limparCloneCompletamente()
        notifyInfo("Clone removido")
    end
end

