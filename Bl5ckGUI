                end
            end
            
            for i, info in ipairs(partesCoresp) do
                if not construindo then return end
                local parte = info.parte
                local dados = info.dados
                pcall(function() F3X:SetName(parte, dados.n) end)
                pcall(function() F3X:Resize(parte, dados.s) end)
                pcall(function() F3X:SetColor(parte, dados.c) end)
