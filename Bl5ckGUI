local KEY_EXPIRE_FILE = "blackgui_expire.txt"
local TEMPO_EXPIRACAO = 35 * 60 -- 35 minutos em segundos

-- FunÃ§Ã£o pra gerar key aleatÃ³ria
local function gerarKey()
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local key = ""
    for i = 1, 16 do
        local rand = math.random(1, #chars)
        key = key .. chars:sub(rand, rand)
    end
    return key
end

-- FunÃ§Ã£o pra salvar key + timestamp
local function salvarKey(key)
    local timestamp = os.time() + TEMPO_EXPIRACAO
    pcall(function()
        writefile(KEY_FILE, key)
        writefile(KEY_EXPIRE_FILE, tostring(timestamp))
    end)
end

-- FunÃ§Ã£o pra verificar se a key ainda Ã© vÃ¡lida
local function keyValida()
    local keySalva = nil
    local expireSalvo = nil
    
    pcall(function()
        if isfile(KEY_FILE) then
            keySalva = readfile(KEY_FILE)
        end
        if isfile(KEY_EXPIRE_FILE) then
            expireSalvo = tonumber(readfile(KEY_EXPIRE_FILE))
        end
    end)
    
    if keySalva and expireSalvo then
        local agora = os.time()
        if agora < expireSalvo then
            return true, keySalva
        end
    end
    
    return false, nil
end

-- FunÃ§Ã£o pra gerar conta matemÃ¡tica
local function gerarConta(dificuldade)
    local a, b, operacao, resultado
    
    if dificuldade == 1 then
        a = math.random(1, 10)
        b = math.random(1, 10)
        operacao = "+"
        resultado = a + b
    elseif dificuldade == 2 then
        a = math.random(2, 12)
        b = math.random(2, 12)
        operacao = "Ã—"
        resultado = a * b
    elseif dificuldade == 3 then
        b = math.random(2, 12)
        resultado = math.random(2, 12)
        a = b * resultado
        operacao = "Ã·"
    elseif dificuldade == 4 then
        a = math.random(2, 5)
        b = math.random(2, 8)
        operacao = "^"
        resultado = a ^ b
    else
        a = math.random(1, 10)
        b = math.random(1, 10)
        local c = math.random(1, 5)
        operacao = "complexa"
        resultado = (a + b) * c
        return string.format("(%d + %d) Ã— %d", a, b, c), resultado
    end
    
    return string.format("%d %s %d", a, operacao, b), resultado
end

