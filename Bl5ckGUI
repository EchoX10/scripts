                if dados.col ~= nil then pcall(function() F3X:SetCollision(parte, dados.col) end) end
                if dados.anc then pcall(function() F3X:Anchor(parte) end) else pcall(function() F3X:Unanchor(parte) end) end
                pcall(function() F3X:SetMaterial(parte, dados.m) end)
            end
            
            task.wait(1.5)
            
            for _, parte in ipairs(partesObby) do
                if not construindo then break end
                if parte.Name == "KillBrick" and not parte:FindFirstChild("ObbyConfigured") then
                    local tag = Instance.new("BoolValue")
                    tag.Name = "ObbyConfigured"
                    tag.Parent = parte
                    local conexao = parte.Touched:Connect(function(hit)
                        local character = hit:FindFirstAncestorOfClass("Model")
                        if character then
                            local player = Players:GetPlayerFromCharacter(character)
                            if player and character:FindFirstChild("Humanoid") then
                                cmdHD(";kill " .. player.Name)
                                cmdHD(";notice " .. player.Name .. " You die!")
                            end
                        end
                    end)
                    table.insert(conexoesObby, conexao)
                elseif parte.Name == "WinPart" and not parte:FindFirstChild("ObbyConfigured") then
                    local tag = Instance.new("BoolValue")
                    tag.Name = "ObbyConfigured"
                    tag.Parent = parte
                    local conexao = parte.Touched:Connect(function(hit)
                        local character = hit:FindFirstAncestorOfClass("Model")
                        if character then
                            local player = Players:GetPlayerFromCharacter(character)
                            if player and character:FindFirstChild("Humanoid") then
                                cmdHD(";notice " .. player.Name .. " You Win!")
                                cmdHD(";title " .. player.Name .. " Winner")
                            end
                        end
                    end)
                    table.insert(conexoesObby, conexao)
                end
            end
            
            construindo = false
            notifySucesso("Obby ativado!")
        end)
    else
        if construindo then
            construindo = false
            task.wait(0.5)
        end
        obbyAtivo = false
        deletarObby()
        task.wait(0.5)
        restaurarMapaAntigo()
        notifyInfo("Obby desativado")
    end
end

