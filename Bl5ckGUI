local function aplicarAnimacaoGrupo(grupo, rotX)
    if not grupo then return end
    for _, parte in ipairs(grupo) do
        local cfAtual = parte.CFrame
        local rotacaoExtra = CFrame.Angles(math.rad(rotX or 0), 0, 0)
        F3X:Move(parte, cfAtual * rotacaoExtra)
    end
end

local function resetarGrupo(grupo)
    if not grupo then return end
    for _, parte in ipairs(grupo) do
        local dados = partOffsets[parte]
        if dados then F3X:Move(parte, dados.originalCF) end
    end
end

local function moverNPC(direcao)
    if not npcPivot then return end
    local velocidade = 0.5
    local dirVec = Vector3.new(0, 0, 0)
    if direcao == "frente" then dirVec = Vector3.new(0, 0, -velocidade)
    elseif direcao == "tras" then dirVec = Vector3.new(0, 0, velocidade)
    elseif direcao == "esquerda" then dirVec = Vector3.new(-velocidade, 0, 0)
    elseif direcao == "direita" then dirVec = Vector3.new(velocidade, 0, 0) end
    
    local novaPosPivot = npcPivot.Position + dirVec
    F3X:Move(npcPivot, CFrame.new(novaPosPivot))
    for parte, dados in pairs(partOffsets) do
        local novaPos = novaPosPivot + dados.offset
        local cfAtual = parte.CFrame
        F3X:Move(parte, CFrame.new(novaPos) * (cfAtual - cfAtual.Position))
    end
end

local function rotacionarNPC(direcao)
    if not npcPivot then return end
    local angulo = direcao == "esquerda" and math.rad(15) or math.rad(-15)
    local cfPivotAtual = npcPivot.CFrame
    local novaCfPivot = cfPivotAtual * CFrame.Angles(0, angulo, 0)
    F3X:Move(npcPivot, novaCfPivot)
    for parte, dados in pairs(partOffsets) do
        local cfAtual = parte.CFrame
        local offset = cfAtual.Position - npcPivot.Position
        local rotacao = CFrame.Angles(0, angulo, 0)
        local rotatedOffset = rotacao:VectorToWorldSpace(offset)
        local novaPos = npcPivot.Position + rotatedOffset
        F3X:Move(parte, CFrame.new(novaPos) * (cfAtual - cfAtual.Position) * rotacao)
    end
end

