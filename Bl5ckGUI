local function criarModeloFlutuante()
    local seBTP = getFork3XEndpoint()
    if not seBTP then
        notifyErro("Building Tools+ não encontrada!")
        return
    end
    
    local char = plr.Character
    if not char then
        notifyErro("Character não encontrado!")
        return
    end
    
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if not torso then
        notifyErro("Torso não encontrado!")
        return
    end
    
    notifyInfo("📦 Criando modelo flutuante...")
    
    -- 1. DEFINIÇÃO DAS PARTES E SUAS PROPRIEDADES
    local defs = {
        ["Part3"] = {cf={-0.2433,6.0213,1.2728,-0.9741,-0.0355,0.2234,-0.0166,0.9962,0.0856,-0.2256,0.0796,-0.9710}, s=Vector3.new(0.08,0.08,0.08), c=Color3.fromRGB(255,191,255), m="Air"},
        ["Part5"] = {cf={0.1319,5.9887,0.5391,-0.8748,-0.0355,0.4832,0.0076,0.9962,0.0868,-0.4845,0.0796,-0.8712}, s=Vector3.new(1.55,1.55,1.55), c=Color3.fromRGB(0,0,0), m="Fabric"},
        ["Part6"] = {cf={1.0896,6.0631,1.3435,-0.9553,-0.0355,-0.2936,-0.0573,0.9962,0.0658,0.2901,0.0797,-0.9537}, s=Vector3.new(0.08,0.08,0.08), c=Color3.fromRGB(255,191,255), m="Air"},
        ["Part4"] = {cf={-0.0347,5.9909,0.9014,-0.8662,-0.0355,0.4985,0.0091,0.9962,0.0867,-0.4996,0.0797,-0.8626}, s=Vector3.new(0.92,0.92,0.92), c=Color3.fromRGB(255,191,255), m="Air"},
        ["Part2"] = {cf={0.9351,6.0223,0.9409,-0.9500,-0.0355,-0.3102,-0.0584,0.9962,0.0648,0.3067,0.0797,-0.9485}, s=Vector3.new(0.92,0.92,0.92), c=Color3.fromRGB(255,200,253), m="Air"},
        ["Part"]  = {cf={0.7669,6.0090,0.5685,-0.7179,-0.0355,-0.6952,-0.0809,0.9962,0.0327,0.6914,0.0797,-0.7180}, s=Vector3.new(1.55,1.55,1.55), c=Color3.fromRGB(0,0,0), m="Fabric"}
    }
    
    local parts = {}
    local localSeguro = Vector3.new(0, -250, 0)
    
    -- 2. CRIAR TODAS AS PARTES NO LOCAL SEGURO
    for nome, dados in pairs(defs) do
        local cf = CFrame.new(dados.cf[1], dados.cf[2], dados.cf[3], dados.cf[4], dados.cf[5], dados.cf[6], dados.cf[7], dados.cf[8], dados.cf[9], dados.cf[10], dados.cf[11], dados.cf[12])
        
        -- Usa o CFrame original para manter a rotação relativa correta ao criar
        local parte = F3X:CreatePart("Normal", CFrame.new(localSeguro), workspace)
        if parte then
            F3X:Resize(parte, dados.s)
            F3X:SetColor(parte, dados.c)
            pcall(function() parte.Material = Enum.Material[dados.m] end)
            F3X:SetCollision(parte, false)
            F3X:Anchor(parte)
            
            -- Aplica o CFrame original (rotação + posição relativa)
            -- Como estamos criando em localSeguro, precisamos ajustar a posição relativa
            -- Mas para simplificar e garantir que a estrutura interna fique certa, 
            -- vamos usar os CFrames originais diretamente no local seguro primeiro
            -- e depois mover o grupo inteiro.
            
            -- Na verdade, a forma mais robusta é criar com o CFrame relativo à origem (0,0,0)
            -- e depois transladar. Mas como você forneceu CFrees absolutos, 
            -- vou criar eles na posição absoluta deles primeiro, soldar, 
            -- e depois mover o "centro de massa" (Part5) para o torso.
            
            -- Recriando na posição absoluta original para preservar a geometria exata
            parte.CFrame = cf 
            
            parts[nome] = parte
        else
            notifyErro("Falha ao criar " .. nome)
            return
        end
    end
    
    task.wait(0.1) -- Espera o servidor registrar as partes
    
    -- 3. FUNÇÃO AUXILIAR PARA SOLDAR VIA BTP
    local function weldServerSide(p1, p2)
        if not p1 or not p2 then return end
        pcall(function()
            seBTP:InvokeServer("CreateConstraints", {p1}, {}, p2, "Weld")
        end)
    end
    
    -- 4. FAZER AS SOLDAS INTERNAS (GRUPAMENTO)
    -- Grupo Esquerdo: Part3 -> Part4 -> Part5
    weldServerSide(parts["Part3"], parts["Part4"])
    weldServerSide(parts["Part4"], parts["Part5"])
    
    -- Grupo Direito: Part6 -> Part2 -> Part5
    weldServerSide(parts["Part6"], parts["Part2"])
    weldServerSide(parts["Part2"], parts["Part5"])
    
    task.wait(0.1)
    
    -- 5. TELEPORTAR O CENTRO DA ESTRUTURA (PART5) PARA ACIMA DO TORSO
    -- Posição alvo: Centro do Torso + 2 studs acima
    local destinoCF = torso.CFrame * CFrame.new(0, 2, 0)
    
    -- Move a Part5 (que agora é o pivô central devido às soldas)
    F3X:Move(parts["Part5"], destinoCF)
    
    -- As outras partes devem seguir automaticamente por causa das soldas, 
    -- mas para garantir que o servidor atualize a física, podemos mover elas também 
    -- ou apenas confiar no Weld. Vamos confiar no Weld server-side.
    
    task.wait(0.1)
    
    -- 6. DESENANCORAR TUDO
    for _, p in pairs(parts) do
        F3X:Unanchor(p)
    end
    
    -- 7. SOLDAR A ESTRUTURA FINAL NO PERSONAGEM
    -- Soldamos a Part5 (centro) e a Part (lado direito/extremo) no Torso para estabilidade dupla
    weldServerSide(parts["Part5"], torso)
    weldServerSide(parts["Part"], torso)
    
    notifySucesso("✅ Modelo flutuante criado e grudado no peito!")
end
    
