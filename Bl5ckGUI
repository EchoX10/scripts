local function salvarMapaAtual()
    notifyInfo("Salvando mapa atual...")
    mapaAntigo = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" and not obj:IsDescendantOf(plr.Character) then
            local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = obj.CFrame:GetComponents()
            table.insert(mapaAntigo, {
                n = obj.Name,
                cf = {x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22},
                s = {obj.Size.X, obj.Size.Y, obj.Size.Z},
                c = {obj.Color.R, obj.Color.G, obj.Color.B},
                m = obj.Material.Name,
                t = obj.Transparency,
                col = obj.CanCollide,
                anc = obj.Anchored
            })
        end
    end
    notifySucesso(#mapaAntigo .. " partes salvas!")
end

local function restaurarMapaAntigo()
    notifyInfo("Restaurando mapa antigo...")
    if #mapaAntigo == 0 then
        notifyErro("Nenhum mapa salvo!")
        return
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local ehPlayer = false
            local parent = obj.Parent
            while parent do
                if parent:IsA("Model") and parent:FindFirstChildOfClass("Humanoid") then
                    ehPlayer = true
                    break
                end
                parent = parent.Parent
            end
            if not ehPlayer then pcall(function() F3X:Remove(obj) end) end
        end
    end
    task.wait(0.5)
    for _, dados in ipairs(mapaAntigo) do
        local cf = CFrame.new(
            dados.cf[1], dados.cf[2], dados.cf[3],
            dados.cf[4], dados.cf[5], dados.cf[6],
            dados.cf[7], dados.cf[8], dados.cf[9],
            dados.cf[10], dados.cf[11], dados.cf[12]
        )
        local parte = F3X:CreatePart("Normal", cf, workspace)
        if parte then
            F3X:Resize(parte, Vector3.new(dados.s[1], dados.s[2], dados.s[3]))
            F3X:SetColor(parte, Color3.new(dados.c[1], dados.c[2], dados.c[3]))
            if dados.t then F3X:SetTransparency(parte, dados.t) end
            if dados.col ~= nil then F3X:SetCollision(parte, dados.col) end
            if dados.anc then F3X:Anchor(parte) else F3X:Unanchor(parte) end
            pcall(function() F3X:SetMaterial(parte, dados.m) end)
            parte.CFrame = cf
        end
    end
    notifySucesso("Mapa restaurado!")
end

