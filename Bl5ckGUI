local function iniciarAnimacaoCabeca()
    if loopCabeca then loopCabeca:Disconnect() end
    loopCabeca = RunService.RenderStepped:Connect(function()
        if not cloneAtivo then return end
        local headClone = partesClone["Head"]
        local headOriginal = plr.Character and plr.Character:FindFirstChild("Head")
        if not headClone or not headOriginal or not headClone.Parent then return end
        local posBase = headOriginal.Position
        local cfBase = headOriginal.CFrame
        local camera = workspace.CurrentCamera
        if not camera then return end
        local mousePos = UserInputService:GetMouseLocation()
        if not mousePos then return end
        local ray = camera:ScreenPointToRay(mousePos.X, mousePos.Y)
        local direcaoMouse = ray.Direction
        local direcaoCabeca = cfBase.LookVector
        local direcaoCabecaUp = cfBase.UpVector
        local dotHorizontal = direcaoCabeca.X * direcaoMouse.X + direcaoCabeca.Z * direcaoMouse.Z
        dotHorizontal = math.clamp(dotHorizontal, -1, 1)
        local anguloYaw = math.acos(dotHorizontal)
        local crossY = direcaoCabeca.X * direcaoMouse.Z - direcaoCabeca.Z * direcaoMouse.X
        if crossY < 0 then anguloYaw = -anguloYaw end
        local yawGraus = math.clamp(math.deg(anguloYaw), -LIMITE_HORIZONTAL, LIMITE_HORIZONTAL)
        local dotVertical = direcaoCabecaUp.X * direcaoMouse.X + direcaoCabecaUp.Y * direcaoMouse.Y + direcaoCabecaUp.Z * direcaoMouse.Z
        dotVertical = math.clamp(dotVertical, -1, 1)
        local anguloPitch = math.acos(dotVertical) - math.rad(90)
        local pitchGraus = math.clamp(math.deg(anguloPitch), -LIMITE_VERTICAL, LIMITE_VERTICAL)
        local rotacaoExtra = CFrame.Angles(math.rad(pitchGraus), math.rad(yawGraus), 0)
        local cfFinal = CFrame.new(posBase) * (cfBase - cfBase.Position) * rotacaoExtra
        pcall(function() F3X:Move(headClone, cfFinal) end)
    end)
end

local function iniciarAnimacaoCorpo()
    if loopAnimacao then loopAnimacao:Disconnect() end
    local bracoEsq = partesClone["Left Arm"]
    local bracoDir = partesClone["Right Arm"]
    local pernaEsq = partesClone["Left Leg"]
    local pernaDir = partesClone["Right Leg"]
    local frameCaminhada = 0
    local tempoFrame = 0
    loopAnimacao = RunService.Heartbeat:Connect(function(dt)
        if not cloneAtivo then return end
        local char = plr.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end
        local velocidade = humanoid.MoveDirection.Magnitude
        local andando = velocidade > 0.1
        local pulando = humanoid.FloorMaterial == Enum.Material.Air
        
        if pulando then
            if bracoEsq then pcall(function() F3X:Move(bracoEsq, bracoEsq.CFrame * CFrame.Angles(math.rad(-120), 0, math.rad(-20))) end) end
            if bracoDir then pcall(function() F3X:Move(bracoDir, bracoDir.CFrame * CFrame.Angles(math.rad(-120), 0, math.rad(20))) end) end
            if pernaEsq then pcall(function() F3X:Move(pernaEsq, pernaEsq.CFrame * CFrame.Angles(math.rad(45), 0, 0)) end) end
            if pernaDir then pcall(function() F3X:Move(pernaDir, pernaDir.CFrame * CFrame.Angles(math.rad(45), 0, 0)) end) end
            return
        end
        
        if andando then
            tempoFrame = tempoFrame + dt
            if tempoFrame >= 0.12 then
                tempoFrame = 0
                frameCaminhada = (frameCaminhada % 4) + 1
            end
            local frame = walkFrames[frameCaminhada]
            if bracoEsq then pcall(function() F3X:Move(bracoEsq, bracoEsq.CFrame * CFrame.Angles(math.rad(frame.bracoEsq), 0, 0)) end) end
            if bracoDir then pcall(function() F3X:Move(bracoDir, bracoDir.CFrame * CFrame.Angles(math.rad(frame.bracoDir), 0, 0)) end) end
            if pernaEsq then pcall(function() F3X:Move(pernaEsq, pernaEsq.CFrame * CFrame.Angles(math.rad(frame.pernaEsq), 0, 0)) end) end
            if pernaDir then pcall(function() F3X:Move(pernaDir, pernaDir.CFrame * CFrame.Angles(math.rad(frame.pernaDir), 0, 0)) end) end
        else
            if frameCaminhada ~= 0 then
                frameCaminhada = 0
                for _, nome in ipairs({"Left Arm", "Right Arm", "Left Leg", "Right Leg"}) do
                    local parte = partesClone[nome]
                    local original = char:FindFirstChild(nome)
                    if parte and original then pcall(function() F3X:Move(parte, original.CFrame) end) end
                end
            end
        end
    end)
end

