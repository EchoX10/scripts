-- ======================================================
-- NOTIFICAÇÃO BONITINHA
-- ======================================================
local function showNotification(text, duration)
    duration = duration or 2.5
    local notif = Instance.new("TextLabel")
    notif.Size = UDim2.new(0, 280, 0, 45)
    notif.Position = UDim2.new(0.5, -140, 0.82, 0)
    notif.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    notif.Text = text
    notif.TextColor3 = Color3.new(1,1,1)
    notif.Font = Enum.Font.Gotham
    notif.TextSize = 14
    notif.Parent = LocalPlayer.PlayerGui
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 12)
    
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -140, 0.76, 0)
    }):Play()
    
    task.delay(duration, function()
        TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            TextTransparency = 1,
            BackgroundTransparency = 1
        }):Play()
        task.wait(0.4)
        notif:Destroy()
    end)
end

-- ======================================================
-- CONFIGURAÇÕES
-- ======================================================
local Flying = false
local GhostMode = false
local Speed = 60 
local UpValue = 0 
local CurrentVelocity = Vector3.new(0, 0, 0)
local TargetVelocity = Vector3.new(0, 0, 0)
local SMOOTHNESS = 8

local BodyVelocity = nil
local BodyGyro = nil
local NoclipConnection = nil

-- 🔧 CORREÇÃO: Estado de colisão salvo
local savedCollideStates = {}
local hasSavedCollide = false

-- Variáveis da GUI
local FlyBtn = nil
local GhostBtn = nil
local MobileFrame = nil

-- ======================================================
-- FUNÇÃO: MANTER ROOTPART INVISÍVEL
-- ======================================================
local function keepRootInvisible()
    if RootPart and RootPart.Parent then
        RootPart.Transparency = 1
        RootPart.CanCollide = false
    end
end

-- ======================================================
-- 🔧 CORREÇÃO: SALVAR ESTADO DE COLISÃO
-- ======================================================
local function CaptureCollideStates()
    savedCollideStates = {}
    if Character then
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                savedCollideStates[part] = part.CanCollide
            end
        end
    end
    hasSavedCollide = true
end

-- ======================================================
-- 🔧 CORREÇÃO: RESTAURAR ESTADO DE COLISÃO
-- ======================================================
local function RestoreCollideStates()
    for part, state in pairs(savedCollideStates) do
        if part and part.Parent then
            part.CanCollide = state
        end
    end
    savedCollideStates = {}
    hasSavedCollide = false
end

-- ======================================================
-- 🔧 CORREÇÃO: ATUALIZAR NOCLIP (SEM QUEBRAR COLISÃO)
-- ======================================================
local function UpdateNoclip()
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end
    
    if GhostMode and Flying then
        -- Salva o estado original ANTES de mexer
        if not hasSavedCollide then
            CaptureCollideStates()
        end
        
        -- Noclip contínuo
        NoclipConnection = RunService.Stepped:Connect(function()
            if Character then
                for _, part in pairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
        showNotification("👻 MODO FANTASMA ATIVADO!")
    else
        -- 🔧 CORREÇÃO: Só restaura se tinha algo salvo
        if hasSavedCollide then
            RestoreCollideStates()
        end
        
        -- Garante que o RootPart continua invisível e sem colisão
        keepRootInvisible()
        
        if GhostMode then
            showNotification("👻 MODO FANTASMA DESATIVADO")
        end
    end
end

-- ======================================================
-- FUNÇÃO: DECOLAGEM
-- ======================================================
local function TakeoffAnimation()
    if not BodyVelocity then return end
    
    local takeoffVelocity = RootPart.CFrame.UpVector * 60
    CurrentVelocity = takeoffVelocity
    
    TweenService:Create(BodyVelocity, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Velocity = Vector3.new(0, 0, 0)
    }):Play()
end

-- ======================================================
-- 🔧 CORREÇÃO: PARAR VOO (COM PROTEÇÕES)
-- ======================================================
local function StopFlyInstant()
    Flying = false
    
    if FlyBtn then
        FlyBtn.Text = "FLY: OFF"
        FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    -- Destroy seguro (pcall pra evitar erro se já foi destruído)
    if BodyVelocity then
        pcall(function() BodyVelocity:Destroy() end)
        BodyVelocity = nil
    end
    
    if BodyGyro then 
        pcall(function() BodyGyro:Destroy() end)
        BodyGyro = nil 
    end

    if Humanoid and Humanoid.Parent then
        pcall(function() Humanoid.PlatformStand = false end)
    end
    
    if MobileFrame then
        MobileFrame.Visible = false
    end
    
    CurrentVelocity = Vector3.new(0, 0, 0)
    TargetVelocity = Vector3.new(0, 0, 0)
    UpValue = 0
    
    UpdateNoclip()
    keepRootInvisible()
    
    showNotification("🛑 VOO DESLIGADO")
end

-- ======================================================
-- 🔧 CORREÇÃO: INICIAR VOO (COM REFRESH)
-- ======================================================
local function StartFly()
    -- Atualiza referências (evita bug do botão travado)
    Character = LocalPlayer.Character
    if not Character or not Character.Parent then
        showNotification("❌ Personagem não encontrado!")
        return
    end
    
    RootPart = Character:FindFirstChild("HumanoidRootPart")
    Humanoid = Character:FindFirstChild("Humanoid")
    
    if not RootPart or not Humanoid or not RootPart.Parent then
        showNotification("❌ Personagem não está pronto! Tente de novo.")
        return
    end
    
    Flying = true
    
    if FlyBtn then
        FlyBtn.Text = "FLY: ON"
        FlyBtn.TextColor3 = Color3.fromRGB(0, 255, 0)
    end
    
    Humanoid.PlatformStand = true

    BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    BodyVelocity.Parent = RootPart

    BodyGyro = Instance.new("BodyGyro")
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.CFrame = RootPart.CFrame
    BodyGyro.Parent = RootPart

    if MobileFrame then
        MobileFrame.Visible = UserInputService.TouchEnabled
    end

    TakeoffAnimation()
    UpdateNoclip()
    keepRootInvisible()
    
    showNotification("🚀 VOO ATIVADO! (Velocidade: " .. Speed .. ")")
end

-- ======================================================
-- 🔧 CORREÇÃO: TOGGLE FLY (COM SYNC CHECK)
-- ======================================================
local function ToggleFly()
    -- 🔧 CORREÇÃO: Atualiza referências ANTES de qualquer coisa
    Character = LocalPlayer.Character
    if not Character or not Character.Parent then
        showNotification("❌ Personagem não encontrado!")
        return
    end
    
    RootPart = Character:FindFirstChild("HumanoidRootPart")
    Humanoid = Character:FindFirstChild("Humanoid")
    
    if not RootPart or not Humanoid or not RootPart.Parent then
        showNotification("❌ Personagem não está pronto! Tente de novo.")
        return
    end
    
    -- 🔧 CORREÇÃO: Detecta se o estado tá dessincronizado
    if Flying and (not BodyVelocity or not BodyGyro) then
        -- Estado dessincronizado - força reset
        Flying = false
    end
    
    if Flying then
        StopFlyInstant()
    else
        StartFly()
    end
end

-- ======================================================
-- MONITOR: MANTER ROOTPART INVISÍVEL
-- ======================================================
task.spawn(function()
    while task.wait(0.1) do
        if not Character or not Character.Parent then
            Character = LocalPlayer.Character
            if Character then
                RootPart = Character:FindFirstChild("HumanoidRootPart")
                Humanoid = Character:FindFirstChild("Humanoid")
            end
        end
        
        if RootPart and RootPart.Parent then
            if RootPart.Transparency ~= 1 then
                RootPart.Transparency = 1
            end
            if RootPart.CanCollide ~= false then
                RootPart.CanCollide = false
            end
        end
    end
end)

-- ======================================================
-- 🔧 CORREÇÃO: QUANDO O PERSONAGEM REVIVE
-- ======================================================
LocalPlayer.CharacterAdded:Connect(function(Char)
    Character = Char
    
    -- 🔧 CORREÇÃO: WaitForChild (mais confiável que task.wait)
    Humanoid = Char:WaitForChild("Humanoid", 5)
    RootPart = Char:WaitForChild("HumanoidRootPart", 5)
    
    -- 🔧 CORREÇÃO: Reset do estado salvo (personagem novo)
    savedCollideStates = {}
    hasSavedCollide = false
    
    if not Humanoid or not RootPart then
        showNotification("⚠️ Erro ao carregar personagem!")
        return
    end
    
    keepRootInvisible()
    
    if Flying then
        Flying = false
        task.wait(0.1)
        
        if BodyVelocity then
            pcall(function() BodyVelocity:Destroy() end)
            BodyVelocity = nil
        end
        if BodyGyro then
            pcall(function() BodyGyro:Destroy() end)
            BodyGyro = nil
        end
        if Humanoid then
            pcall(function() Humanoid.PlatformStand = false end)
        end
        if FlyBtn then
            FlyBtn.Text = "FLY: OFF"
            FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end
        
        showNotification("🔄 REVIVEU - Voo desligado")
    end
end)

