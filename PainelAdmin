local function criarParteTexturizada(posicao)
    local parteWrapper = F3X:CreatePart("Normal", CFrame.new(posicao), workspace)
    if not parteWrapper then return nil end
    F3X:Resize(parteWrapper, PART_SIZE)
    task.wait(0.001)
    local parteReal = acharParteReal(posicao, PART_SIZE) or parteWrapper
    table.insert(partesCriadas, parteReal)
    task.spawn(function() texturizar(parteReal, false) end)
    animarParte(parteReal)
    return parteReal
end

local function iniciarSpam()
    if spamLigado then return end
    spamLigado = true
    task.spawn(function()
        while spamLigado do
            for _, p in ipairs(Players:GetPlayers()) do
                if not spamLigado then break end
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
