-- ============== ARMADILHA DE JOGADOR ==============
local function armarArmadilha(jogadorAlvo)
    if not jogadorAlvo or not jogadorAlvo.Character then
        warn("[Armadilha] Jogador inválido")
        return
    end
    if not F3X then
        warn("[Armadilha] F3X não carregado")
        return
    end

    print("[Armadilha] Iniciando para:", jogadorAlvo.Name)

    local posicaoOriginal = nil
    if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
        posicaoOriginal = plr.Character.HumanoidRootPart.CFrame
    end

    cmdHD(";teleport me " .. TRAP_POSITION.X .. "," .. TRAP_POSITION.Y .. "," .. TRAP_POSITION.Z)
    task.wait(0.8)

    pcall(function()
        local chao = F3X:CreatePart("Normal", CFrame.new(TRAP_POSITION.X, TRAP_POSITION.Y - TRAP_SIZE.Y/2, TRAP_POSITION.Z), workspace)
        if chao then F3X:Resize(chao, Vector3.new(TRAP_SIZE.X, 0.5, TRAP_SIZE.Z)) end
    end)
    task.wait(0.1)

    pcall(function()
        local teto = F3X:CreatePart("Normal", CFrame.new(TRAP_POSITION.X, TRAP_POSITION.Y + TRAP_SIZE.Y/2, TRAP_POSITION.Z), workspace)
        if teto then F3X:Resize(teto, Vector3.new(TRAP_SIZE.X, 0.5, TRAP_SIZE.Z)) end
    end)
    task.wait(0.1)

    pcall(function()
        local frente = F3X:CreatePart("Normal", CFrame.new(TRAP_POSITION.X, TRAP_POSITION.Y, TRAP_POSITION.Z + TRAP_SIZE.Z/2), workspace)
        if frente then F3X:Resize(frente, Vector3.new(TRAP_SIZE.X, TRAP_SIZE.Y, 0.5)) end
    end)
    task.wait(0.1)

    pcall(function()
        local tras = F3X:CreatePart("Normal", CFrame.new(TRAP_POSITION.X, TRAP_POSITION.Y, TRAP_POSITION.Z - TRAP_SIZE.Z/2), workspace)
        if tras then F3X:Resize(tras, Vector3.new(TRAP_SIZE.X, TRAP_SIZE.Y, 0.5)) end
    end)
    task.wait(0.1)

    pcall(function()
        local esquerda = F3X:CreatePart("Normal", CFrame.new(TRAP_POSITION.X - TRAP_SIZE.X/2, TRAP_POSITION.Y, TRAP_POSITION.Z), workspace)
        if esquerda then F3X:Resize(esquerda, Vector3.new(0.5, TRAP_SIZE.Y, TRAP_SIZE.Z)) end
    end)
    task.wait(0.1)

    pcall(function()
        local direita = F3X:CreatePart("Normal", CFrame.new(TRAP_POSITION.X + TRAP_SIZE.X/2, TRAP_POSITION.Y, TRAP_POSITION.Z), workspace)
        if direita then F3X:Resize(direita, Vector3.new(0.5, TRAP_SIZE.Y, TRAP_SIZE.Z)) end
    end)
    task.wait(0.5)

    cmdHD(";teleport " .. jogadorAlvo.Name)
    task.wait(0.5)

    if posicaoOriginal then
        cmdHD(";teleport me " .. posicaoOriginal.Position.X .. "," .. posicaoOriginal.Position.Y .. "," .. posicaoOriginal.Position.Z)
    end

    print("[Armadilha] Concluída!")
end

