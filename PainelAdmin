    local function criarParteComCFrame(dados)
        local cf = CFrame.new(
            dados.cf[1], dados.cf[2], dados.cf[3],
            dados.cf[4], dados.cf[5], dados.cf[6],
            dados.cf[7], dados.cf[8], dados.cf[9],
            dados.cf[10], dados.cf[11], dados.cf[12]
        )
        
        local parte = F3X:CreatePart("Normal", cf, workspace)
        
        if parte then
            F3X:Resize(parte, dados.s)
            F3X:SetColor(parte, dados.c)
            F3X:Anchor(parte)
            F3X:SetCollision(parte, true)
            parte.CFrame = cf
        end
        
        return parte
    end

    local partesAntigas = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(plr.Character) then
            table.insert(partesAntigas, obj)
        end
    end
    print("[MapaRápido] 📦 " .. #partesAntigas .. " partes antigas.")

    print("[MapaRápido] 🛡️ Criando chão de proteção...")
    local partesProtecao = {}
    for _, dados in ipairs(MEU_BLUEPRINT) do
        if dados.n == "Floor" or dados.n == "Terrain" then
            local parte = criarParteComCFrame(dados)
            if parte then
                table.insert(partesProtecao, parte)
            end
        end
    end
    task.wait(1.5)
    print("[MapaRápido] ✅ Chão criado!")

    print("[MapaRápido] 🗑️ Deletando mapa antigo...")
    task.spawn(function()
        for _, obj in ipairs(partesAntigas) do
            if obj and obj.Parent then
                pcall(function() obj:Destroy() end)
            end
        end
        print("[MapaRápido] ✅ Mapa antigo limpo!")
    end)

    print("[MapaRápido] 🏗️ Construindo resto do mapa...")
    task.spawn(function()
        local construidas = 0
        for _, dados in ipairs(MEU_BLUEPRINT) do
            if dados.n ~= "Floor" and dados.n ~= "Terrain" then
                criarParteComCFrame(dados)
                construidas = construidas + 1
                if construidas % 20 == 0 then task.wait(0.01) end
            end
        end
        print("[MapaRápido] ✅ Mapa construído!")
        
        print("[MapaRápido] 🧹 Removendo chão de proteção...")
        task.wait(2)
        for _, parte in ipairs(partesProtecao) do
            if parte and parte.Parent then
                pcall(function() parte:Destroy() end)
            end
        end
        print("[MapaRápido] 🎉 Concluído!")
    end)
end

-- ============== ACESSÓRIO DE CINTURA (CORRIGIDO: APONTANDO PRA FRENTE) ==============
local function botaoAcessorioCintura()
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local corPersonagem = torso and torso.Color or Color3.fromRGB(100, 100, 100)

    local function criarESoldar(forma, tamanho, cframeRelativo)
        local cfAbsoluto = hrp.CFrame * cframeRelativo
        local parte = F3X:CreatePart(forma, cfAbsoluto, workspace)
        if parte then
            F3X:Resize(parte, tamanho)
            F3X:SetColor(parte, corPersonagem)
            F3X:SetCollision(parte, false)
            
            local solda = Instance.new("WeldConstraint")
            solda.Part0 = hrp
            solda.Part1 = parte
            solda.Parent = hrp
        end
        return parte
    end

    -- Bolas na cintura (frente)
    criarESoldar("Ball", Vector3.new(1.2, 1.2, 1.2), CFrame.new(-1.3, -1.8, 1.2))
    criarESoldar("Ball", Vector3.new(1.2, 1.2, 1.2), CFrame.new(1.3, -1.8, 1.2))
    
    -- Cilindro no meio: 
    -- math.rad(90) no eixo Y faz ele apontar para FRENTE (Z) em vez de ficar de lado.
    -- math.rad(35) no eixo X inclina ele 35 graus para CIMA.
    criarESoldar("Cylinder", Vector3.new(0.8, 1.5, 0.8), CFrame.new(0, -1.8, 1.2) * CFrame.Angles(math.rad(35), math.rad(90), 0))

    print("[Acessório] Criado na frente da cintura apontando para frente!")
end

