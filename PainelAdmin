-- ============== FACES E TEXTURA ==============
local TODAS_FACES = {
    Enum.NormalId.Front, Enum.NormalId.Back,
    Enum.NormalId.Left,  Enum.NormalId.Right,
    Enum.NormalId.Top,   Enum.NormalId.Bottom
}
local FACES_SPAM = {Enum.NormalId.Front, Enum.NormalId.Back}

local function texturizarUmaFace(parte, face)
    pcall(function()
        se:InvokeServer("CreateTextures", {{
            Part = parte, Face = face, TextureType = "Decal"
        }})
    end)
    pcall(function()
        se:InvokeServer("SyncTexture", {{
            Part = parte, Face = face, TextureType = "Decal",
            Texture = "rbxassetid://" .. TEXTURE_ID
        }})
    end)
end

local function texturizar(parte, todasFaces)
    local faces = todasFaces and TODAS_FACES or FACES_SPAM
    for _, face in ipairs(faces) do
        texturizarUmaFace(parte, face)
    end
end

-- ============== BUSCAR PARTE REAL ==============
local function acharParteReal(posicao, tamanho)
    local parteReal, menorDist = nil, math.huge
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") then
            local d = (obj.Position - posicao).Magnitude
            local tamDiff = (obj.Size - tamanho).Magnitude
            if d < 3 and tamDiff < 0.5 and d < menorDist then
                menorDist = d
                parteReal = obj
            end
        end
    end
    return parteReal
end

