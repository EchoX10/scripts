    {id = 138981629726601, vol = 9999, pitch = 0.8, nome = "Phonk Slowed Real"},
}
local presetIndex = 2

local musicaLigada = false
local musicaTask = nil
local currentId    = MUSIC_PRESETS[presetIndex].id
local currentVol   = MUSIC_PRESETS[presetIndex].vol
local currentPitch = MUSIC_PRESETS[presetIndex].pitch
local currentName  = MUSIC_PRESETS[presetIndex].nome
local MUSIC_ID_STR = tostring(currentId)

local musicToggleBtn = nil
local presetBtn = nil

local function atualizarTextoToggle()
    if musicToggleBtn then
        local estado = musicaLigada and "\n[ LIGADO ]" or "\n[ DESLIGADO ]"
        musicToggleBtn.Text = " Música IMORTAL [" .. currentName .. "]" .. estado
    end
end

local function encontrarMusicaAtual()
    local locais = {workspace, SoundService, plr}
    if plr:FindFirstChild("PlayerGui") then table.insert(locais, plr.PlayerGui) end
    if plr:FindFirstChild("PlayerScripts") then table.insert(locais, plr.PlayerScripts) end
    if plr:FindFirstChild("Backpack") then table.insert(locais, plr.Backpack) end
    if plr.Character then table.insert(locais, plr.Character) end

    for _, local_ in ipairs(locais) do
        for _, obj in ipairs(local_:GetDescendants()) do
            if obj:IsA("Sound") then
                local sid = tostring(obj.SoundId)
                if string.find(sid, MUSIC_ID_STR, 1, true) then
                    return obj
                end
            end
        end
    end
    return nil
end

local function tocarMusica()
    cmdHD(";music " .. currentId)
    task.wait(0.5)
    cmdHD(";volume " .. currentVol)
    task.wait(0.3)
    cmdHD(";pitch " .. currentPitch)
end

local function ligarMusica()
    if musicaLigada then return end
    musicaLigada = true
    atualizarTextoToggle()
    tocarMusica()

    musicaTask = task.spawn(function()
        local ultimoAviso = 0
        local ultimoEstado = nil
        while musicaLigada do
            task.wait(0.5)
            if not musicaLigada then break end

            local som = encontrarMusicaAtual()
            local agora = tick()
            local estado
            if not som then estado = "ausente"
            elseif not som.Playing then estado = "parado"
            elseif som.TimeLength > 0 and som.TimePosition >= som.TimeLength - 0.5 then estado = "terminando"
            else estado = "tocando" end

            if estado ~= ultimoEstado then
                print("[Guardião] Estado:", estado)
                ultimoEstado = estado
            end

            if (estado == "ausente" or estado == "parado" or estado == "terminando") then
                if (agora - ultimoAviso) > 2 then
                    ultimoAviso = agora
                    task.spawn(function() tocarMusica() end)
                end
            else
                pcall(function() som.Looped = true end)
            end
        end
    end)
end

local function desligarMusica()
    musicaLigada = false
    atualizarTextoToggle()
    if musicaTask then pcall(function() task.cancel(musicaTask) end) musicaTask = nil end
    cmdHD(";unmusic")
    task.wait(0.4)
    cmdHD(";pitch 1")
    task.wait(0.3)
    cmdHD(";volume 1")
end

local function trocarPreset()
    presetIndex = presetIndex + 1
    if presetIndex > #MUSIC_PRESETS then presetIndex = 1 end

    local p = MUSIC_PRESETS[presetIndex]
    currentId    = p.id
    currentVol   = p.vol
    currentPitch = p.pitch
    currentName  = p.nome
    MUSIC_ID_STR = tostring(currentId)

    print("[Preset] Trocado para:", currentName, "(ID: " .. currentId .. ")")
    atualizarTextoToggle()

    if musicaLigada then
        cmdHD(";unmusic")
        task.wait(0.3)
        task.spawn(function() tocarMusica() end)
    end
end

