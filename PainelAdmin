-- ============== METEORITO GIGANTE ==============
local function botaoMeteorito()
    print("[Meteorito] Iniciando...")
    local posicaoCeu = Vector3.new(0, 500, 0)
    local parte = F3X:CreatePart("Normal", CFrame.new(posicaoCeu), workspace)
    if not parte then warn("[Meteorito] Falha ao criar parte"); return end
    F3X:Resize(parte, Vector3.new(100, 100, 100))
    task.wait(0.5)
    F3X:Unanchor(parte)
    print("[Meteorito] Parte criada e desancorada, caindo...")

    task.spawn(function()
        local tempoParado = 0
        while parte and parte.Parent do
            local velocidade = parte.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
            if velocidade.Magnitude < 1 then
                tempoParado = tempoParado + 0.1
                if tempoParado > 0.5 then
                    print("[Meteorito] Colidiu! Criando bola vermelha...")
                    local pontoImpacto = parte.Position
                    local bola = F3X:CreatePart("Ball", CFrame.new(pontoImpacto), workspace)
                    if bola then
                        F3X:Resize(bola, Vector3.new(10, 10, 10))
                        F3X:SetColor(bola, Color3.fromRGB(255, 0, 0))
                        F3X:SetTransparency(bola, 0.4)
                        F3X:Anchor(bola)
                        pcall(function() F3X:Remove(parte) end)
                        
                        local tamanhoAtual = 10
                        local tamanhoMax = 1500
                        local incremento = 50
                        print("[Meteorito] Bola crescendo...")
                        while tamanhoAtual < tamanhoMax and bola and bola.Parent do
                            tamanhoAtual = tamanhoAtual + incremento
                            pcall(function() F3X:Resize(bola, Vector3.new(tamanhoAtual, tamanhoAtual, tamanhoAtual)) end)
                            task.wait(0.05)
                        end
                        task.wait(1)
                        pcall(function() F3X:Remove(bola) end)
                        print("[Meteorito] Concluído!")
                    end
                    break
                end
            else
                tempoParado = 0
            end
            task.wait(0.1)
        end
    end)
end

-- ============== BANDEIRA COLORIDA (ORDEM CORRIGIDA) ==============
local function botaoBandeira()
    print("[Bandeira] Iniciando construção...")
    local posicaoBase = Vector3.new(0, 5, 0)
    local largura = 20
    local profundidade = 2

    local cores = {
        Color3.fromRGB(200, 100, 180),
        Color3.fromRGB(245, 169, 184),
        Color3.fromRGB(255, 230, 0),
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(255, 230, 0),
        Color3.fromRGB(80, 200, 240),
        Color3.fromRGB(91, 206, 250)
    }
    local alturas = {1, 1, 1, 2, 1, 1, 1}
    local alturaAtual = posicaoBase.Y

    for i, cor in ipairs(cores) do
        local altura = alturas[i]
        local posicaoFaixa = Vector3.new(posicaoBase.X, alturaAtual + altura/2, posicaoBase.Z)
        local parte = F3X:CreatePart("Normal", CFrame.new(posicaoFaixa), workspace)
        if parte then
            F3X:Resize(parte, Vector3.new(largura, altura, profundidade))
            F3X:SetColor(parte, cor)
            F3X:Anchor(parte)
            alturaAtual = alturaAtual + altura
            task.wait(0.05)
        end
    end
    print("[Bandeira] Construção concluída!")
end

