-- ============== ANIMAÇÃO DE PARTES (SUBIR + FADE OUT) ==============
local function animarParte(parte)
    if not parte then return end
    pcall(function() F3X:SetName(parte, "partículas fakes") end)
    pcall(function() F3X:Anchor(parte) end)
    
    task.spawn(function()
        local transparencia = 0
        local alturaSubida = 0
        local velocidadeSubida = 0.5
        local velocidadeFade = 0.05
        
        while parte and parte.Parent and transparencia < 1 do
            alturaSubida = alturaSubida + velocidadeSubida
            local novaPos = parte.Position + Vector3.new(0, velocidadeSubida, 0)
            pcall(function() F3X:Move(parte, CFrame.new(novaPos)) end)
            
            transparencia = transparencia + velocidadeFade
            if transparencia > 1 then transparencia = 1 end
            pcall(function() F3X:SetTransparency(parte, transparencia) end)
            
            task.wait(0.05)
        end
        
        if parte and parte.Parent then
            pcall(function() F3X:Remove(parte) end)
        end
    end)
end

