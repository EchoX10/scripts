local latestUpdateCode, latestSha, latestName = nil, nil, nil

function checkForUpdate(silent)
    updateStatus.Text = "Status: Verificando..."
    updateStatus.TextColor3 = Color3.fromRGB(255,200,100)

    local result = httpGet(GITHUB_API)
    if not result then
        updateStatus.Text = "Status: Erro ao conectar"
        updateStatus.TextColor3 = Color3.fromRGB(255,80,80)
        return
    end

    local ok, files = pcall(function() return HttpService:JSONDecode(result) end)
    if not ok or type(files) ~= "table" then
        updateStatus.Text = "Status: Resposta invalida"
        updateStatus.TextColor3 = Color3.fromRGB(255,80,80)
        return
    end

    local best, bestNum = nil, -1
    for _, f in ipairs(files) do
        if f.type == "file" and f.name:match("%.lua$") then
            local num = tonumber(f.name:match("(%d+)")) or 0
            if num > bestNum then bestNum = num; best = f end
        end
    end

    if not best then updateStatus.Text = "Status: Nenhum script"; return end

    local lastSha = isfile(LAST_SHA_FILE) and readfile(LAST_SHA_FILE) or ""
    if best.sha == lastSha then
        updateStatus.Text = "Status: Atualizado (" .. best.name .. ")"
        updateStatus.TextColor3 = Color3.fromRGB(0,255,100)
        DoUpdateBtn.Visible = false
        if not silent then createNotification("CoolExec ja atualizado!", Color3.fromRGB(0,255,100)) end
        return
    end

    latestSha, latestName = best.sha, best.name
    updateStatus.Text = "Status: Nova versao -> " .. best.name
    updateStatus.TextColor3 = Color3.fromRGB(0,255,150)
    DoUpdateBtn.Visible = true

    if not silent then createNotification("Nova versao: " .. best.name, Color3.fromRGB(0,255,150)) end

    task.spawn(function()
        local code = httpGet(best.download_url)
        if code and #code > 50 then latestUpdateCode = code end
    end)
end

CheckUpdateBtn.MouseButton1Click:Connect(function() checkForUpdate(false) end)

DoUpdateBtn.MouseButton1Click:Connect(function()
    if not latestUpdateCode or #latestUpdateCode < 50 then
        createNotification("Baixando, aguarde...", Color3.fromRGB(255,200,0))
        if latestName then
            local code = httpGet(GITHUB_RAW_BASE .. latestName)
            if code and #code > 50 then latestUpdateCode = code
            else createNotification("Falha ao baixar", Color3.fromRGB(255,80,80)); return end
        else return end
    end

    createNotification("Atualizando...", Color3.fromRGB(0,200,255))
    if latestSha then pcall(writefile, LAST_SHA_FILE, latestSha) end

    local codeToRun = latestUpdateCode

    pcall(function() if ScreenGui then ScreenGui:Destroy() end end)
    pcall(function() if TutorialGui then TutorialGui:Destroy() end end)
    pcall(function() if MsgDialogGui then MsgDialogGui:Destroy() end end)
    pcall(function() if SaveDialogGui then SaveDialogGui:Destroy() end end)
    pcall(function() if Notifications then Notifications:Destroy() end end)
    pcall(function() if MiniConsoleGui then MiniConsoleGui:Destroy() end end)

    task.wait(0.4)
    pcall(function()
        (function() local fn,e=safeLoadstring(codeToRun); if not fn then error(tostring(e)) end; return fn() end)()
    end)
end)

