                    local n = input.Text:gsub("[^%w%s_-]", "")
                    if n == "" or n == entry.name then promptGui:Destroy() return end
                    if entry.isFolder then
                        local newPath = parentPath .. "/" .. n
                        if isfolder(newPath) then createNotification("❌ Pasta já existe", Color3.fromRGB(255,80,80)) return end
                        makefolder(newPath)
                        local ok, files = pcall(listfiles, entry.path)
                        if ok then
                            for _, f in ipairs(files) do
                                local fname = f:match("([^/\\]+)$")
                                if isfile(f) then writefile(newPath.."/"..fname, readfile(f)) pcall(delfile, f) end
                            end
                        end
                        pcall(function() if delfolder then delfolder(entry.path) end end)
                    else
                        local newPath = parentPath .. "/" .. n .. ".lua"
                        if isfile(newPath) then createNotification("❌ Script já existe", Color3.fromRGB(255,80,80)) return end
