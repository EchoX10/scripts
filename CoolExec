local function openMsgDialog()
    MsgDialogGui.Enabled = true
    MsgDialog.BackgroundTransparency = 1
    MsgDialog.Size = UDim2.new(0, 280, 0, 150)
    MsgDialogStroke.Transparency = 1
    MsgDialogTitle.TextTransparency = 1
    MsgDialogClose.TextTransparency = 1
    MsgInput.TextTransparency = 1
    MsgInput.BackgroundTransparency = 0.3
    MsgCancelBtn.TextTransparency = 1
    MsgSendBtn.TextTransparency = 1
    
    MsgInput.Text = ""
    
    TweenService:Create(MsgDialog, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {
        Size = UDim2.new(0, 350, 0, 180),
        BackgroundTransparency = 0
    }):Play()
    TweenService:Create(MsgDialogStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
    TweenService:Create(MsgDialogTitle, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(MsgDialogClose, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(MsgInput, TweenInfo.new(0.3), {TextTransparency = 0, BackgroundTransparency = 0.3}):Play()
    TweenService:Create(MsgCancelBtn, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(MsgSendBtn, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    
    MsgInput:CaptureFocus()
end

local function closeMsgDialog()
    TweenService:Create(MsgDialog, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
        Size = UDim2.new(0, 280, 0, 150),
        BackgroundTransparency = 1
    }):Play()
    TweenService:Create(MsgDialogStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
    TweenService:Create(MsgDialogTitle, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    TweenService:Create(MsgDialogClose, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    TweenService:Create(MsgInput, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    TweenService:Create(MsgCancelBtn, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    TweenService:Create(MsgSendBtn, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    
    task.wait(0.3)
    MsgDialogGui.Enabled = false
    MsgInput:ReleaseFocus()
end

local function sendMessage()
    local msg = MsgInput.Text
    if not msg or msg:match("^%s*$") then
        createNotification("❌ Digite uma mensagem!", Color3.fromRGB(255, 80, 80))
        return
    end
    
    closeMsgDialog()
    sendWebhookMessage(msg)
end

