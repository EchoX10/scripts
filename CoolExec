-- ==================== WEBHOOK COM PALAVRAS-CHAVE ====================
local WEBHOOKS_FILE = "coolexec/webhooks.json"
local selectedWebhookIndex = 1

local function loadWebhooks()
    if isfile(WEBHOOKS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(WEBHOOKS_FILE)) end)
        if ok and type(data) == "table" and #data > 0 then
            return data
        end
    end
    -- Migração do arquivo antigo de URL única
    if isfile(WEBHOOK_FILE) then
        local old = readfile(WEBHOOK_FILE)
        if old and old ~= "" then
            return {{name = "Principal", url = old}}
        end
    end
    return {}
end

local function saveWebhooks(list)
    writefile(WEBHOOKS_FILE, HttpService:JSONEncode(list))
end

local webhookList = loadWebhooks()

local function getWebhookUrl()
    if #webhookList == 0 then return nil end
    if selectedWebhookIndex < 1 or selectedWebhookIndex > #webhookList then
        selectedWebhookIndex = 1
    end
    return webhookList[selectedWebhookIndex].url
end

local function setWebhookUrl(url)
    -- Compatibilidade: adiciona como webhook principal se lista vazia
    if #webhookList == 0 then
        table.insert(webhookList, {name = "Principal", url = url})
    else
        webhookList[selectedWebhookIndex].url = url
    end
    saveWebhooks(webhookList)
    return true
end

local function sendWebhookMessage(message)
    local url = getWebhookUrl()
    if not url or url == "" then
        createNotification("❌ Nenhum WebHook configurado!", Color3.fromRGB(255, 80, 80))
        return false
    end
    
    -- ===== COLETAR INFORMAÇÕES =====
    local playerName = player.Name
    local playerId = player.UserId
    local playerTeam = (player.Team and player.Team.Name) or "Sem time"
    local playerHealth = humanoid and math.floor(humanoid.Health) or "N/A"
    local playerMaxHealth = humanoid and math.floor(humanoid.MaxHealth) or "N/A"
    local playerPosition = rootPart and string.format("%.1f, %.1f, %.1f", rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z) or "N/A"
    local playerWalkSpeed = humanoid and math.floor(humanoid.WalkSpeed) or "N/A"
    local playerJumpPower = humanoid and math.floor(humanoid.JumpPower) or "N/A"
    
    -- Informações do servidor
    local players = Players:GetPlayers()
    local playerCount = #players
    local playerNames = {}
    for _, plr in ipairs(players) do
        table.insert(playerNames, "- " .. plr.Name)
    end
    local playerList = table.concat(playerNames, "\n")
    
    -- Jogador aleatório
    local randomPlayer = "N/A"
    if #players > 0 then
        local randomIndex = math.random(1, #players)
        randomPlayer = players[randomIndex].Name
    end
    
    -- Informações do jogo
    local gameName = "Desconhecido"
    local gameId = game.PlaceId or "N/A"
    local placeId = game.PlaceId or "N/A"
    local serverRegion = "N/A"
    
    pcall(function()
        local productInfo = MarketplaceService:GetProductInfo(game.PlaceId)
        if productInfo and productInfo.Name then
            gameName = productInfo.Name
        end
    end)
    
    -- Data e hora
    local date = os.date("%d/%m/%Y")
    local time = os.date("%H:%M:%S")
    local dateTime = os.date("%d/%m/%Y %H:%M:%S")
    local timestamp = os.time()
    
    -- Estatísticas do CoolExec
    local uptime = os.time() - coolExecStartTime
    local uptimeStr = string.format("%dh %dm %ds", math.floor(uptime / 3600), math.floor((uptime % 3600) / 60), uptime % 60)
    local fps = "N/A"
    pcall(function()
        fps = math.floor(1 / task.wait())
    end)
    
    local ping = "N/A"
    pcall(function()
        ping = math.floor(game:GetService("Stats"):GetAveragePing())
    end)
    
    -- ===== SUBSTITUIR PALAVRAS-CHAVE =====
    local processedMessage = message
    
    -- 👤 Jogador
    processedMessage = processedMessage:gsub("{MyUserName}", playerName)
    processedMessage = processedMessage:gsub("{MyUserID}", tostring(playerId))
    processedMessage = processedMessage:gsub("{MyTeam}", playerTeam)
    processedMessage = processedMessage:gsub("{MyHealth}", tostring(playerHealth))
    processedMessage = processedMessage:gsub("{MyMaxHealth}", tostring(playerMaxHealth))
    processedMessage = processedMessage:gsub("{MyPosition}", playerPosition)
    processedMessage = processedMessage:gsub("{MyWalkSpeed}", tostring(playerWalkSpeed))
    processedMessage = processedMessage:gsub("{MyJumpPower}", tostring(playerJumpPower))
    processedMessage = processedMessage:gsub("{MyFPS}", tostring(fps))
    processedMessage = processedMessage:gsub("{MyPing}", tostring(ping))
    
    -- 👥 Servidor
    processedMessage = processedMessage:gsub("{PeopleCounter}", tostring(playerCount))
    processedMessage = processedMessage:gsub("{UsernameListPlayers}", playerList)
    processedMessage = processedMessage:gsub("{PlayerCount}", tostring(playerCount))
    processedMessage = processedMessage:gsub("{GameName}", gameName)
    processedMessage = processedMessage:gsub("{GameID}", tostring(gameId))
    processedMessage = processedMessage:gsub("{PlaceID}", tostring(placeId))
    processedMessage = processedMessage:gsub("{ServerRegion}", serverRegion)
    processedMessage = processedMessage:gsub("{RandomPlayer}", randomPlayer)
    
    -- ⏰ Data/Hora
    processedMessage = processedMessage:gsub("{Date}", date)
    processedMessage = processedMessage:gsub("{Time}", time)
    processedMessage = processedMessage:gsub("{DateTime}", dateTime)
    processedMessage = processedMessage:gsub("{Timestamp}", tostring(timestamp))
    
    -- 📊 CoolExec
    processedMessage = processedMessage:gsub("{ScriptsExecuted}", tostring(scriptCount))
    processedMessage = processedMessage:gsub("{Uptime}", uptimeStr)
    
    -- ===== ENVIAR MENSAGEM =====
    local success = false
    
    if request then
        success, _ = pcall(function()
            return request({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({content = processedMessage})
            })
        end)
    end
    
    if not success then
        success, _ = pcall(function()
            return HttpService:PostAsync(url, HttpService:JSONEncode({content = processedMessage}), Enum.HttpContentType.ApplicationJson)
        end)
    end
    
    if not success and syn and syn.request then
        success, _ = pcall(function()
            return syn.request({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({content = processedMessage})
            })
        end)
    end
    
    if success then
        createNotification("✅ Mensagem enviada!", Color3.fromRGB(0, 255, 100))
        addConsoleLine("📨 Mensagem enviada para WebHook!", Color3.fromRGB(0, 255, 100))
        addMiniConsoleLine("📨 Mensagem enviada!", Color3.fromRGB(0, 255, 100))
        return true
    else
        createNotification("❌ Erro ao enviar! Verifique sua URL", Color3.fromRGB(255, 80, 80))
        return false
    end
end

