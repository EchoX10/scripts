-- Sistema de empilhamento de notificações
local activeNotifications = {}
local NOTIF_HEIGHT = 60
local NOTIF_GAP = 8
local NOTIF_WIDTH = 280
local NOTIF_DURATION = 4

local function updateNotificationStack()
    for i, notifData in ipairs(activeNotifications) do
        local targetY = -80 - ((i - 1) * (NOTIF_HEIGHT + NOTIF_GAP))
        TweenService:Create(notifData.frame, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            Position = UDim2.new(1, -NOTIF_WIDTH - 20, 1, targetY)
        }):Play()
    end
end

local function createNotification(text, color)
    -- Respeita a configuração de notificações
    if settings and settings.notifications == false then
        return
    end
    
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, NOTIF_WIDTH, 0, NOTIF_HEIGHT)
    notif.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    notif.BackgroundTransparency = 1
    notif.Parent = Notifications
    notif.ZIndex = 1000
    notif.ClipsDescendants = true

    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = color
    stroke.Thickness = 1.5
    stroke.Transparency = 1

    local label = Instance.new("TextLabel", notif)
    label.Size = UDim2.new(1, -20, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextTransparency = 1
    label.TextScaled = true
    label.Font = Enum.Font.GothamSemibold
    label.TextWrapped = true
    label.ZIndex = 1000

    -- Posição inicial (fora da tela, à direita)
    notif.Position = UDim2.new(1, 20, 1, -80)

    -- Adiciona na lista de notificações ativas
    local notifData = {frame = notif, stroke = stroke, label = label}
    table.insert(activeNotifications, 1, notifData) -- nova notificação no topo da pilha

    -- Atualiza as posições de todas (empilha)
    updateNotificationStack()

    -- Animação de entrada
    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.1
    }):Play()
    TweenService:Create(stroke, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {Transparency = 0}):Play()
    TweenService:Create(label, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {TextTransparency = 0}):Play()

    -- Remove depois do tempo
    task.delay(NOTIF_DURATION, function()
        if not notif or not notif.Parent then return end

        -- Animação de saída
        TweenService:Create(notif, TweenInfo.new(0.35, Enum.EasingStyle.Quint), {
            BackgroundTransparency = 1,
            Position = UDim2.new(1, 20, notif.Position.Y.Scale, notif.Position.Y.Offset)
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.35), {Transparency = 1}):Play()
        TweenService:Create(label, TweenInfo.new(0.35), {TextTransparency = 1}):Play()

        task.wait(0.4)

        -- Remove da lista
        for i, data in ipairs(activeNotifications) do
            if data.frame == notif then
                table.remove(activeNotifications, i)
                break
            end
        end

        if notif and notif.Parent then
            notif:Destroy()
        end

        -- Reorganiza a pilha depois de remover
        updateNotificationStack()
    end)
end

