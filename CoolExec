            Instance.new("UICorner", container).CornerRadius = UDim.new(0, 5)
            
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(0.55, 0, 1, 0)
            btn.BackgroundTransparency = 1
            btn.Text = (entry.isFolder and "📁 " or "📄 ") .. entry.name
