-- Função para atualizar o tamanho do canvas corretamente
local function updateTutorialCanvas()
    -- Força o TextLabel a calcular o tamanho real do texto
    TutorialContent.Size = UDim2.new(1, -20, 0, 9999) -- altura temporária grande
    task.wait() -- espera um frame para o TextBounds atualizar
    local textHeight = TutorialContent.TextBounds.Y + 30
    TutorialContent.Size = UDim2.new(1, -20, 0, textHeight)
    TutorialScroll.CanvasSize = UDim2.new(0, 0, 0, textHeight + 20)
end

local function openTutorial()
    TutorialGui.Enabled = true
    TutorialFrame.BackgroundTransparency = 1
    TutorialFrame.Size = UDim2.new(0, 420, 0, 340)
    TutorialStroke.Transparency = 1
    TutorialTitle.TextTransparency = 1
    TutorialCloseBtn.TextTransparency = 1
    TutorialScroll.Visible = true
    TutorialScroll.CanvasPosition = Vector2.new(0, 0)
    
    TweenService:Create(TutorialFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {
        Size = UDim2.new(0, 520, 0, 420),
        BackgroundTransparency = 0
    }):Play()
    TweenService:Create(TutorialStroke, TweenInfo.new(0.3), {Transparency = 0}):Play()
    TweenService:Create(TutorialTitle, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    TweenService:Create(TutorialCloseBtn, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    
    -- Atualiza o canvas depois que a janela abre
    task.delay(0.15, updateTutorialCanvas)
end

local function closeTutorial()
    TweenService:Create(TutorialFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
        Size = UDim2.new(0, 420, 0, 340),
        BackgroundTransparency = 1
    }):Play()
    TweenService:Create(TutorialStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
    TweenService:Create(TutorialTitle, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    TweenService:Create(TutorialCloseBtn, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
    
    task.wait(0.3)
    TutorialGui.Enabled = false
end

