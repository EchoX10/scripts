-- ===== AUTO-EXECUTAR SCRIPTS AO ENTRAR =====
local function autoExecuteScripts()
    local autoScripts = {}
    for _, file in ipairs(listfiles(AUTOEXEC_FOLDER)) do
        if file:find("%.auto$") then
            local name = file:match("([^/\\]+)%.auto$")
            table.insert(autoScripts, name)
        end
    end
    
    if #autoScripts > 0 then
        task.wait(2)
        for _, name in ipairs(autoScripts) do
            local scriptPath = SAVE_FOLDER .. "/" .. name .. ".lua"
            if isfile(scriptPath) then
                local content = readfile(scriptPath)
                local success, err = pcall(function()
                    loadstring(content)()
                end)
                if success then
                    addConsoleLine("🔄 Auto-executou: " .. name, Color3.fromRGB(0, 255, 100))
                    addMiniConsoleLine("🔄 Auto-executou: " .. name, Color3.fromRGB(0, 255, 100))
                else
                    addConsoleLine("❌ Erro auto-exec: " .. name .. " - " .. tostring(err), Color3.fromRGB(255, 50, 50))
                end
            end
        end
        createNotification("🔄 " .. #autoScripts .. " scripts auto-executados!", Color3.fromRGB(0, 255, 100))
    end
end

-- ===== FUNÇÕES DO SCRIPT =====
local function executeScript(code)
    scriptCount = scriptCount + 1
    
    if not code or code:match("^%s*$") then
        createNotification("⚠️ Digite um script!", Color3.fromRGB(255, 200, 0))
        return
    end
    
    addConsoleLine("▶️ Executando script...", Color3.fromRGB(100, 200, 255))
    addMiniConsoleLine("▶️ Executando...", Color3.fromRGB(100, 200, 255))
    
    local success, err = pcall(function()
        loadstring(code)()
    end)
    
    if success then
        createNotification("✅ Script executado!", Color3.fromRGB(0, 255, 100))
        addConsoleLine("✅ Script executado com sucesso!", Color3.fromRGB(0, 255, 100))
        addMiniConsoleLine("✅ Sucesso!", Color3.fromRGB(0, 255, 100))
    else
        createNotification("❌ Erro: " .. tostring(err), Color3.fromRGB(255, 80, 80))
        addConsoleLine("❌ Erro: " .. tostring(err), Color3.fromRGB(255, 50, 50))
        addMiniConsoleLine("❌ Erro: " .. tostring(err), Color3.fromRGB(255, 50, 50))
    end
end

-- ==================== HUB COM PASTAS + BUSCA ====================
local currentHubPath = SAVE_FOLDER

local function getRelativePath()
    local rel = currentHubPath:gsub("^" .. SAVE_FOLDER, "")
    if rel == "" then return "/saved" end
    return "/saved" .. rel:gsub("\\", "/")
end

local function getHubEntries()
    local entries = {}
    local ok, files = pcall(listfiles, currentHubPath)
    if not ok then return entries end
    
    for _, file in ipairs(files) do
        local name = file:match("([^/\\]+)$")
        if isfolder(file) then
            table.insert(entries, {name = name, path = file, isFolder = true})
        elseif file:find("%.lua$") then
            table.insert(entries, {name = name:gsub("%.lua$", ""), path = file, isFolder = false})
        end
    end
    table.sort(entries, function(a, b)
        if a.isFolder ~= b.isFolder then return a.isFolder end
        return a.name:lower() < b.name:lower()
    end)
    return entries
end

local function refreshHub(filter)
    filter = filter or "all"
    local search = (HubSearchBox and HubSearchBox.Text or ""):lower()
    
    for _, child in ipairs(HubList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
    
    if HubPathLabel then
        HubPathLabel.Text = "📁 " .. getRelativePath()
    end
    
    -- Botão voltar se não estiver na raiz
    if currentHubPath ~= SAVE_FOLDER then
        local back = Instance.new("TextButton")
        back.Size = UDim2.new(1, -10, 0, 32)
        back.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
        back.Text = "⬅️  .. (Voltar)"
        back.TextColor3 = Color3.fromRGB(200, 200, 255)
        back.TextScaled = true
        back.Font = Enum.Font.GothamBold
        back.Parent = HubList
        Instance.new("UICorner", back).CornerRadius = UDim.new(0, 5)
        back.MouseButton1Click:Connect(function()
            currentHubPath = currentHubPath:match("(.+)[/\\][^/\\]+$") or SAVE_FOLDER
            refreshHub(filter)
        end)
    end
    
    local entries = getHubEntries()
    local shown = 0
    
    for _, entry in ipairs(entries) do
        if search ~= "" and not entry.name:lower():find(search, 1, true) then
            -- skip
        else
            shown = shown + 1
            local container = Instance.new("Frame")
