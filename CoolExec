local oldPrint = print
local oldWarn = warn
local oldError = error

print = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    oldPrint(...)
    addConsoleLine("[PRINT] " .. msg, Color3.fromRGB(0, 255, 120))
    addMiniConsoleLine("[PRINT] " .. msg, Color3.fromRGB(0, 255, 120))
end

warn = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    oldWarn(...)
    addConsoleLine("[WARN] " .. msg, Color3.fromRGB(255, 200, 0))
    addMiniConsoleLine("[WARN] " .. msg, Color3.fromRGB(255, 200, 0))
end

error = function(msg, level)
    oldError(msg, level)
    addConsoleLine("[ERROR] " .. tostring(msg), Color3.fromRGB(255, 50, 50))
    addMiniConsoleLine("[ERROR] " .. tostring(msg), Color3.fromRGB(255, 50, 50))
end

