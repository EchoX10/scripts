    local scriptPath = autoExecPath .. "CoolExec.lua"
    if not isfile(scriptPath) then
        local source = debug.getinfo(1).source
        if source and source:sub(1, 1) == "@" then
            local currentFile = source:sub(2)
            if isfile(currentFile) then
                writefile(scriptPath, readfile(currentFile))
                print("✅ CoolExec instalado no autoexec!")
            end
        end
    end
end
