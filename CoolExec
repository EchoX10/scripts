local function autoExecuteScripts()
    local autoScripts = {}
    for _, file in ipairs(listfiles(AUTOEXEC_FOLDER)) do
        if file:find("%.auto$") then
            local name = file:match("([^/\\]+)%.auto$")
            table.insert(autoScripts, name)
        end
    end
    if #autoScripts > 0 then
        task.wait(2)
        for _, name in ipairs(autoScripts) do
            local scriptPath = SAVE_FOLDER .. "/" .. name .. ".lua"
            if isfile(scriptPath) then
                local content = readfile(scriptPath)
                local success = pcall(function()
                    (function() local fn,e=safeLoadstring(content); if not fn then error(tostring(e)) end; return fn() end)()
                end)
                if success then addConsoleLine("Auto: " .. name) end
            end
        end
        createNotification(#autoScripts .. " auto-executados!", Color3.fromRGB(0,255,100))
    end
end

-- Execute
function executeScript(code)
    scriptCount = scriptCount + 1
    if not code or code:match("^%s*$") then
        createNotification("Digite um script!", Color3.fromRGB(255,200,0))
        playSound("error"); return
    end
    addConsoleLine("Executando...")
    playSound("click")

    local success, err = pcall(function()
        (function() local fn,e=safeLoadstring(code); if not fn then error(tostring(e)) end; return fn() end)()
    end)

    if success then
        playSound("success")
        createNotification("Script executado!", Color3.fromRGB(0,255,100))
        addConsoleLine("Sucesso!")
    else
        playSound("error")
        createNotification(tostring(err), Color3.fromRGB(255,80,80))
        addConsoleLine("Erro: " .. tostring(err))
    end
end

-- Hub
local currentHubPath = SAVE_FOLDER

function getRelativePath()
    local rel = currentHubPath:gsub("^" .. SAVE_FOLDER, "")
    rel = rel:gsub("\\", "/")
    if rel == "" then return "/saved" end
    return "/saved" .. rel
end

local function getHubEntries(searchQuery)
    local entries = {}
    searchQuery = (searchQuery or ""):lower()

    local function scan(path, prefix)
        local ok, files = pcall(listfiles, path)
        if not ok then return end
        for _, file in ipairs(files) do
            local name = file:match("([^/\\]+)$")
            if isfolder(file) then
                local display = prefix ~= "" and (prefix .. "/" .. name) or name
                if searchQuery == "" then
                    if path == currentHubPath then
                        table.insert(entries, {name=name, path=file, isFolder=true, display=name})
                        scan(file, display)
                    end
                else
                    if name:lower():find(searchQuery, 1, true) then
                        table.insert(entries, {name=name, path=file, isFolder=true, display=display})
                    end
                    scan(file, display)
                end
            elseif file:find("%.lua$") then
                local sname = name:gsub("%.lua$", "")
                local display = prefix ~= "" and (prefix .. "/" .. sname) or sname
                if searchQuery == "" then
                    if path == currentHubPath then
                        table.insert(entries, {name=sname, path=file, isFolder=false, display=sname})
                    end
                else
                    if sname:lower():find(searchQuery, 1, true) or display:lower():find(searchQuery, 1, true) then
                        table.insert(entries, {name=sname, path=file, isFolder=false, display=display})
                    end
                end
            end
        end
    end

    if searchQuery ~= "" then scan(SAVE_FOLDER, "") else scan(currentHubPath, "") end

    table.sort(entries, function(a, b)
        if a.isFolder ~= b.isFolder then return a.isFolder end
        return (a.display or a.name):lower() < (b.display or b.name):lower()
    end)
    return entries
end

