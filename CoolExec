local latestUpdateCode = nil
local latestSha = nil
local latestName = nil

local function checkForUpdate(silent)
    updateStatus.Text = "Status: Verificando no GitHub..."
    updateStatus.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    local success, result = pcall(function()
        local response
        if request then
            response = request({Url = GITHUB_API, Method = "GET"})
            return response.Body
        elseif syn and syn.request then
            response = syn.request({Url = GITHUB_API, Method = "GET"})
            return response.Body
        else
            return game:HttpGet(GITHUB_API)
        end
    end)
    
    if not success or not result then
        updateStatus.Text = "Status: ❌ Erro ao conectar no GitHub"
        updateStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    local ok, files = pcall(function() return HttpService:JSONDecode(result) end)
    if not ok or type(files) ~= "table" then
        updateStatus.Text = "Status: ❌ Resposta inválida do GitHub"
        updateStatus.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    -- Pega o script com maior número no nome (Script2 > Script1) ou o mais recente
    local best = nil
    local bestNum = -1
    for _, f in ipairs(files) do
        if f.type == "file" and f.name:match("%.lua$") then
            local num = tonumber(f.name:match("(%d+)")) or 0
            if num > bestNum then
                bestNum = num
                best = f
            end
        end
    end
    
    if not best then
        updateStatus.Text = "Status: Nenhum script encontrado na pasta upgrades"
        return
    end
    
    local lastSha = isfile(LAST_SHA_FILE) and readfile(LAST_SHA_FILE) or ""
    
    if best.sha == lastSha then
        updateStatus.Text = "Status: ✅ Você já está na versão mais recente (" .. best.name .. ")"
        updateStatus.TextColor3 = Color3.fromRGB(0, 255, 100)
        DoUpdateBtn.Visible = false
        if not silent then
            createNotification("✅ CoolExec já está atualizado!", Color3.fromRGB(0, 255, 100))
        end
        return
    end
    
    -- Tem update
    latestSha = best.sha
    latestName = best.name
    updateStatus.Text = "Status: 🆕 Nova versão disponível → " .. best.name
    updateStatus.TextColor3 = Color3.fromRGB(0, 255, 150)
    DoUpdateBtn.Visible = true
    
    if not silent then
        createNotification("🆕 Nova versão encontrada: " .. best.name, Color3.fromRGB(0, 255, 150))
    end
    
    -- Pré-baixa o código
    task.spawn(function()
        local ok2, code = pcall(function()
            if request then
                local r = request({Url = best.download_url, Method = "GET"})
                return r.Body
            else
                return game:HttpGet(best.download_url)
            end
        end)
        if ok2 and code and #code > 50 then
            latestUpdateCode = code
        end
    end)
end

CheckUpdateBtn.MouseButton1Click:Connect(function()
    checkForUpdate(false)
end)

DoUpdateBtn.MouseButton1Click:Connect(function()
    if not latestUpdateCode or #latestUpdateCode < 50 then
        createNotification("⏳ Baixando atualização, aguarde 2 segundos e tente de novo...", Color3.fromRGB(255, 200, 0))
        -- tenta baixar de novo na hora
        if latestName then
            local ok, code = pcall(function()
                local url = GITHUB_RAW_BASE .. latestName
                if request then
                    local r = request({Url = url, Method = "GET"})
                    return r.Body
                else
                    return game:HttpGet(url)
                end
            end)
            if ok and code and #code > 50 then
                latestUpdateCode = code
            else
                createNotification("❌ Falha ao baixar o script de atualização", Color3.fromRGB(255, 80, 80))
                return
            end
        else
            return
        end
    end
    
    createNotification("⬇️ Atualizando... Fechando CoolExec e executando nova versão", Color3.fromRGB(0, 200, 255))
    
    -- Salva o novo SHA
    if latestSha then
        pcall(writefile, LAST_SHA_FILE, latestSha)
    end
    
    -- Guarda o código antes de destruir tudo
    local codeToRun = latestUpdateCode
    
    -- Destrói TODAS as GUIs do CoolExec por referência (mais seguro)
    pcall(function() if ScreenGui then ScreenGui:Destroy() end end)
    pcall(function() if TutorialGui then TutorialGui:Destroy() end end)
    pcall(function() if MsgDialogGui then MsgDialogGui:Destroy() end end)
    pcall(function() if SaveDialogGui then SaveDialogGui:Destroy() end end)
    pcall(function() if Notifications then Notifications:Destroy() end end)
    pcall(function() if MiniConsole and MiniConsole.Parent then MiniConsole:Destroy() end end)
    
    -- Limpeza extra por nome (caso tenha sobrado algo)
    pcall(function()
        for _, gui in ipairs(CoreGui:GetChildren()) do
            local n = gui.Name:lower()
            if n:find("cool") or n:find("tutorial") or n:find("msgdialog") or n:find("savedialog") or n:find("notification") or n:find("ce_") or n:find("renameprompt") then
                gui:Destroy()
            end
        end
    end)
    
    task.wait(0.4)
    
    -- Executa o novo script
    local success, err = pcall(function()
        loadstring(codeToRun)()
    end)
    
    if not success then
        warn("[CoolExec Update] Erro ao carregar nova versão:", err)
        -- tenta de novo uma vez
        pcall(function() loadstring(codeToRun)() end)
    end
end)

