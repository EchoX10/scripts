end

warn = function(...)
    local args = {...}
    local msg = table.concat(args, " ")
    oldWarn(...)
    addConsoleLine("[WARN] " .. msg)
end

error = function(msg, level)
    oldError(msg, level)
    addConsoleLine("[ERROR] " .. tostring(msg))
end

