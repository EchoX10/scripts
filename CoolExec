            renameBtn.Size = UDim2.new(0.1, 0, 0.8, 0)
            renameBtn.Position = UDim2.new(0.55, 0, 0.1, 0)
            renameBtn.BackgroundTransparency = 1
            renameBtn.Text = "✏️"
            renameBtn.TextColor3 = Color3.fromRGB(255, 200, 50)
            renameBtn.TextScaled = true
            renameBtn.Font = Enum.Font.GothamBold
            renameBtn.Parent = container
            renameBtn.MouseButton1Click:Connect(function()
                local parentPath = entry.path:match("(.+)[/\\][^/\\]+$") or currentHubPath
