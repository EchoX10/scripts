function makefolder(p) if type(_makefolder)=="function" then return pcall(_makefolder,p) end return false end
function listfiles(p) if type(_listfiles)=="function" then local o,r=pcall(_listfiles,p); if o and type(r)=="table" then return r end end return {} end
