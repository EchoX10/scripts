            BackgroundColor3 = bg,
            Size = UDim2.new(btn.Size.X.Scale, btn.Size.X.Offset, 0, 36)
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.18), {Transparency = 0.85}):Play()
    end)
end

