-- Webhooks
local WEBHOOKS_FILE = "coolexec/webhooks.json"
local selectedWebhookIndex = 1

local function loadWebhooks()
    if isfile(WEBHOOKS_FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(WEBHOOKS_FILE)) end)
        if ok and type(data) == "table" and #data > 0 then return data end
    end
    if isfile(WEBHOOK_FILE) then
        local old = readfile(WEBHOOK_FILE)
        if old and old ~= "" then return {{name="Principal", url=old}} end
    end
    return {}
end

local function saveWebhooks(list)
    writefile(WEBHOOKS_FILE, HttpService:JSONEncode(list))
end

local webhookList = loadWebhooks()

local function getWebhookUrl()
    if #webhookList == 0 then return nil end
    if selectedWebhookIndex < 1 or selectedWebhookIndex > #webhookList then selectedWebhookIndex = 1 end
    return webhookList[selectedWebhookIndex].url
end

local function httpPost(url, body)
    if request then
        local ok = pcall(request, {Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        if ok then return true end
    end
    if syn and syn.request then
        local ok = pcall(syn.request, {Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        if ok then return true end
    end
    if http_request then
        local ok = pcall(http_request, {Url=url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=body})
        if ok then return true end
    end
    return pcall(function() return HttpService:PostAsync(url, body, Enum.HttpContentType.ApplicationJson) end)
end

local function httpGet(url)
    if request then
        local ok, r = pcall(request, {Url=url, Method="GET"})
        if ok and r and r.Body then return r.Body end
    end
    if syn and syn.request then
        local ok, r = pcall(syn.request, {Url=url, Method="GET"})
        if ok and r and r.Body then return r.Body end
    end
    if http_request then
        local ok, r = pcall(http_request, {Url=url, Method="GET"})
        if ok and r and r.Body then return r.Body end
    end
    local ok, b = pcall(function() return game:HttpGet(url) end)
    if ok then return b end
    return nil
end

local function sendWebhookMessage(message)
    local url = getWebhookUrl()
    if not url or url == "" then
        createNotification("Nenhum WebHook configurado!", Color3.fromRGB(255,80,80))
        return false
    end

    local players = Players:GetPlayers()
    local playerNames = {}
    for _, plr in ipairs(players) do table.insert(playerNames, "- " .. plr.Name) end
    local playerList = table.concat(playerNames, "\n")

    local gameName = "Desconhecido"
    pcall(function()
        local pi = MarketplaceService:GetProductInfo(game.PlaceId)
        if pi and pi.Name then gameName = pi.Name end
    end)

    local randomPlayer = "N/A"
    if #players > 0 then randomPlayer = players[math.random(1, #players)].Name end

    local uptime = os.time() - coolExecStartTime
    local uptimeStr = string.format("%dh %dm %ds", math.floor(uptime/3600), math.floor((uptime%3600)/60), uptime%60)

    local fps, ping = 60, 0
    pcall(function() fps = math.floor(1 / task.wait()) end)
    pcall(function() ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end)

    local msg = message
    local reps = {
        ["{MyUserName}"] = player.Name,
        ["{MyUserID}"] = tostring(player.UserId),
        ["{MyTeam}"] = (player.Team and player.Team.Name) or "Sem time",
        ["{MyHealth}"] = tostring(humanoid and math.floor(humanoid.Health) or "N/A"),
        ["{MyMaxHealth}"] = tostring(humanoid and math.floor(humanoid.MaxHealth) or "N/A"),
        ["{MyPosition}"] = rootPart and string.format("%.1f, %.1f, %.1f", rootPart.Position.X, rootPart.Position.Y, rootPart.Position.Z) or "N/A",
        ["{MyWalkSpeed}"] = tostring(humanoid and math.floor(humanoid.WalkSpeed) or "N/A"),
        ["{MyJumpPower}"] = tostring(humanoid and math.floor(humanoid.JumpPower or 0) or "N/A"),
        ["{MyFPS}"] = tostring(fps),
        ["{MyPing}"] = tostring(ping),
        ["{PeopleCounter}"] = tostring(#players),
        ["{UsernameListPlayers}"] = playerList,
        ["{PlayerCount}"] = tostring(#players),
        ["{GameName}"] = gameName,
        ["{GameID}"] = tostring(game.PlaceId),
        ["{PlaceID}"] = tostring(game.PlaceId),
        ["{ServerRegion}"] = "N/A",
        ["{RandomPlayer}"] = randomPlayer,
        ["{Date}"] = os.date("%d/%m/%Y"),
        ["{Time}"] = os.date("%H:%M:%S"),
        ["{DateTime}"] = os.date("%d/%m/%Y %H:%M:%S"),
        ["{Timestamp}"] = tostring(os.time()),
        ["{ScriptsExecuted}"] = tostring(scriptCount),
        ["{Uptime}"] = uptimeStr,
    }
    for k, v in pairs(reps) do msg = msg:gsub(k, v) end

    local body = HttpService:JSONEncode({content = msg})
    if httpPost(url, body) then
        createNotification("Mensagem enviada!", Color3.fromRGB(0,255,100))
        addConsoleLine("Mensagem enviada para WebHook!")
        return true
    else
        createNotification("Erro ao enviar! Verifique URL", Color3.fromRGB(255,80,80))
        return false
    end
end

