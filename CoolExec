local activeNotifications = {}
local NOTIF_HEIGHT, NOTIF_GAP, NOTIF_WIDTH, NOTIF_DURATION = 60, 8, 280, 4

local function updateNotificationStack()
    for i, nd in ipairs(activeNotifications) do
        local targetY = -80 - ((i - 1) * (NOTIF_HEIGHT + NOTIF_GAP))
        TweenService:Create(nd.frame, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
            Position = UDim2.new(1, -NOTIF_WIDTH - 20, 1, targetY)
        }):Play()
    end
end

function createNotification(text, color)
    if settings and settings.notifications == false then return end
    playSound("notify")

    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, NOTIF_WIDTH, 0, NOTIF_HEIGHT)
    notif.BackgroundColor3 = Color3.fromRGB(20,20,20)
    notif.BackgroundTransparency = 1
    notif.Parent = Notifications
    notif.ZIndex = 1000
    notif.ClipsDescendants = true
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = color; stroke.Thickness = 1.5; stroke.Transparency = 1

    local label = Instance.new("TextLabel", notif)
    label.Size = UDim2.new(1, -20, 1, 0); label.Position = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1; label.Text = text
    label.TextColor3 = Color3.fromRGB(255,255,255); label.TextTransparency = 1
    label.TextScaled = true; label.Font = Enum.Font.GothamSemibold
    label.TextWrapped = true; label.ZIndex = 1000

    notif.Position = UDim2.new(1, 20, 1, -80)
    local nd = {frame=notif, stroke=stroke, label=label}
    table.insert(activeNotifications, 1, nd)
    updateNotificationStack()

    TweenService:Create(notif, TweenInfo.new(0.4, Enum.EasingStyle.Quint), {BackgroundTransparency = 0.1}):Play()
    TweenService:Create(stroke, TweenInfo.new(0.4), {Transparency = 0}):Play()
    TweenService:Create(label, TweenInfo.new(0.4), {TextTransparency = 0}):Play()

    task.delay(NOTIF_DURATION, function()
        if not notif or not notif.Parent then return end
        TweenService:Create(notif, TweenInfo.new(0.35, Enum.EasingStyle.Quint), {
            BackgroundTransparency = 1,
            Position = UDim2.new(1, 20, notif.Position.Y.Scale, notif.Position.Y.Offset)
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.35), {Transparency = 1}):Play()
        TweenService:Create(label, TweenInfo.new(0.35), {TextTransparency = 1}):Play()
        task.wait(0.4)
        for i, d in ipairs(activeNotifications) do
            if d.frame == notif then table.remove(activeNotifications, i); break end
        end
        if notif and notif.Parent then notif:Destroy() end
        updateNotificationStack()
    end)
end

