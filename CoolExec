local function saveScript()
    local name = DialogInput.Text
    if not name or name:match("^%s*$") then
        createNotification("❌ Nome inválido!", Color3.fromRGB(255, 80, 80))
        return
    end
    
    name = name:gsub("[^%w%s_-]", "")
    if name:match("^%s*$") then
        createNotification("❌ Nome inválido!", Color3.fromRGB(255, 80, 80))
        return
    end
    
    local code = ScriptBox.Text
    if code:match("^%s*$") then
        createNotification("❌ Nada para salvar!", Color3.fromRGB(255, 80, 80))
        return
    end
    
    local filePath = currentHubPath .. "/" .. name .. ".lua"
    if isfile(filePath) then
        createNotification("⚠️ Script já existe nesta pasta!", Color3.fromRGB(255, 200, 0))
        return
    end
    
    writefile(filePath, code)
    createNotification("✅ Script '" .. name .. "' salvo em " .. getRelativePath(), Color3.fromRGB(0, 255, 100))
    refreshHub("all")
    closeSaveDialog()
end

